# Unit cube used by the renderer check.
# 8 positions, 4 uvs, 6 normals, 6 quad faces (triangulated by meshc).

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vt 0 0
vt 1 0
vt 1 1
vt 0 1

vn  0  0  1
vn  0  0 -1
vn  1  0  0
vn -1  0  0
vn  0  1  0
vn  0 -1  0

# +Z
f 5/1/1 6/2/1 7/3/1 8/4/1
# -Z
f 2/1/2 1/2/2 4/3/2 3/4/2
# +X
f 6/1/3 2/2/3 3/3/3 7/4/3
# -X
f 1/1/4 5/2/4 8/3/4 4/4/4
# +Y
f 8/1/5 7/2/5 3/3/5 4/4/5
# -Y
f 1/1/6 2/2/6 6/3/6 5/4/6
