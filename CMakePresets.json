{
  "version": 6,
  "configurePresets": [
    {
      "name": "3ds",
      "displayName": "Nintendo 3DS (devkitARM, RelWithDebInfo)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/3ds",
      "toolchainFile": "$env{DEVKITPRO}/cmake/3DS.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "desktop",
      "displayName": "Desktop host (MinGW, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "3ds", "configurePreset": "3ds" },
    { "name": "desktop", "configurePreset": "desktop" }
  ],
  "testPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "output": { "outputOnFailure": true }
    }
  ]
}
