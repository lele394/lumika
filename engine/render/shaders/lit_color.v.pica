; e3d lit, vertex-coloured shader (no texture)
; v0 position, v1 colour, v3 normal

.fvec mvp[4]
.fvec model[4]
.fvec lightDir[1]
.fvec tint[1]
.fvec params[1]

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1
.alias innrm v3

.constf one(1.0, 1.0, 1.0, 1.0)
.constf zero(0.0, 0.0, 0.0, 0.0)

.proc main
	mov r0.xyz, inpos
	mov r0.w, one.x

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	; normal -> world
	mov r1.xyz, innrm
	mov r1.w, zero.x
	dp4 r2.x, model[0], r1
	dp4 r2.y, model[1], r1
	dp4 r2.z, model[2], r1

	dp3 r3.x, r2, r2
	rsq r3.x, r3.x
	mul r2.xyz, r2.xyz, r3.x

	; intensity = ambient + diffuse * max(dot(n, lightDir), 0)
	dp3 r4.x, lightDir[0], r2
	mov r5.x, zero.x
	max r4.x, r4.x, r5.x
	mov r6.x, params[0].x
	mov r7.x, params[0].y
	mul r4.x, r4.x, r7.x
	add r4.x, r4.x, r6.x

	mov r8, tint[0]
	mov r9, inclr
	mul r10.xyz, r9.xyz, r4.x
	mul outclr, r8, r10

	end
.end
