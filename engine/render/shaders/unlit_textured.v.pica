; e3d unlit, textured vertex shader for 2D sprites and text
; Inputs: v0 position, v2 uv
; Uniforms: mvp[4], tint

.fvec mvp[4]
.fvec tint[1]

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias inuv  v2

.constf one(1.0, 1.0, 1.0, 1.0)

.proc main
	mov r0.xyz, inpos
	mov r0.w, one.x

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	mov outtc0, inuv
	mov outclr, tint[0]

	end
.end
